<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>

<configuration>

    <!-- Cada bloque tendrá dos copias -->
    <property>
        <name>dfs.replication</name>
        <value>2</value>
    </property>

    <!-- Metadata administrada por el NameNode -->
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>file:///data/hdfs/namenode</value>
    </property>

    <!-- Bloques almacenados por cada DataNode -->
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>file:///data/hdfs/datanode</value>
    </property>

    <!-- Interfaz web del NameNode -->
    <property>
        <name>dfs.namenode.http-address</name>
        <value>0.0.0.0:9870</value>
    </property>

    <!-- Utilizar nombres Docker para identificar los DataNodes -->
    <property>
        <name>dfs.datanode.use.datanode.hostname</name>
        <value>true</value>
    </property>

    <property>
        <name>dfs.client.use.datanode.hostname</name>
        <value>true</value>
    </property>

    <!-- Habilitar acceso WebHDFS -->
    <property>
        <name>dfs.webhdfs.enabled</name>
        <value>true</value>
    </property>

        <!-- Tiempos reducidos solamente para el laboratorio -->
    <property>
        <name>dfs.heartbeat.interval</name>
        <value>3</value>
    </property>

    <property>
        <name>dfs.namenode.heartbeat.recheck-interval</name>
        <value>10000</value>
    </property>

</configuration>