<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>

<configuration>

    <!-- Ejecutar MapReduce sobre YARN -->
    <property>
        <name>mapreduce.framework.name</name>
        <value>yarn</value>
    </property>

    <!-- Bibliotecas necesarias dentro de los contenedores YARN -->
    <property>
        <name>mapreduce.application.classpath</name>
        <value>/opt/hadoop/share/hadoop/mapreduce/*:/opt/hadoop/share/hadoop/mapreduce/lib/*</value>
    </property>

    <!-- Memoria del ApplicationMaster -->
    <property>
        <name>yarn.app.mapreduce.am.resource.mb</name>
        <value>512</value>
    </property>

    <property>
        <name>yarn.app.mapreduce.am.command-opts</name>
        <value>-Xmx384m</value>
    </property>

    <!-- Recursos para las tareas Map -->
    <property>
        <name>mapreduce.map.memory.mb</name>
        <value>512</value>
    </property>

    <property>
        <name>mapreduce.map.java.opts</name>
        <value>-Xmx384m</value>
    </property>

    <property>
        <name>mapreduce.map.cpu.vcores</name>
        <value>1</value>
    </property>

    <!-- Recursos para las tareas Reduce -->
    <property>
        <name>mapreduce.reduce.memory.mb</name>
        <value>512</value>
    </property>

    <property>
        <name>mapreduce.reduce.java.opts</name>
        <value>-Xmx384m</value>
    </property>

    <property>
        <name>mapreduce.reduce.cpu.vcores</name>
        <value>1</value>
    </property>

</configuration>