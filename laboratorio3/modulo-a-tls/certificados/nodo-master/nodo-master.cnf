[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[dn]
C = EC
ST = Guayas
L = Guayaquil
O = Universidad
OU = Sistemas Distribuidos
CN = nodo-master

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = nodo-master
DNS.2 = localhost
IP.1 = 127.0.0.1
